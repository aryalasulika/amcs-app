APP_NAME="AMCS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://amcs.test

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Makassar

AMCS_AIRPORT_NAME="Bandara Syukuran Aminuddin Amir Luwuk"
AMCS_AIRPORT_ICAO="WAMW"
AMCS_DELAY_THRESHOLD_MINUTES=30
AMCS_REALTIME_BROADCAST=true
AMCS_REALTIME_POLL_SECONDS=3
AMCS_REALTIME_FALLBACK_POLL_SECONDS=15
AMCS_SEED_PASSWORD=Amcs#2026

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=amcs
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Laravel Reverb (WebSocket). Generate fresh values for production.
REVERB_APP_ID=123456
REVERB_APP_KEY=amcs-local-key
REVERB_APP_SECRET=amcs-local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=*
AMCS_REVERB_CLIENT_HOST=localhost
AMCS_REVERB_CLIENT_PORT=8080
AMCS_REVERB_CLIENT_SCHEME=http

CACHE_STORE=database

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,amcs.test

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
